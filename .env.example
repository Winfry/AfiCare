# ── AfiCare MediLink — Environment Variables ──────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Supabase (used by the Python agent)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# AI / LLM (used by the AI agent for symptom analysis)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# NOTE: The Python AI backend (aficare-backend.up.railway.app) is DISABLED.
# The Flutter app + MedicalAIService run fully offline/local-only. The
# variables below are optional and only used if you self-host the agent.
# Optional: Railway deployment token
RAILWAY_TOKEN=your-railway-token-here
